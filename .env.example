# CTX Protocol API Key
# Get it from ctxprotocol.com dashboard.
CTX_API_KEY=your_ctx_api_key_here

# Moz API Credentials
# Requires a paid plan (moz.com/products/api).
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# Moz API rate limit budget (optional — safe defaults applied)
# MOZ_HOURLY_LIMIT=200
# MOZ_DAILY_LIMIT=2000
# MOZ_CONCURRENCY=10

# Default number of results returned when the caller omits the limit argument.
# Lower values = fewer Moz rows consumed per request (referring-domains costs 1 + N rows).
# Max allowed is 100. Recommended: 20 (matches Moz Starter plan row budget).
MOZ_DEFAULT_BACKLINKS_LIMIT=20
MOZ_DEFAULT_REFERRING_DOMAINS_LIMIT=20

# Skip the one-shot cache warm job (optional — set to true if DB is not persisted across deployments)
# SKIP_CACHE_WARM=true

# Server port
# HTTP port the MCP server listens on.
PORT=8000

# SQLite database path
# Path to the SQLite cache database file.
DB_PATH=./backlinq.db
