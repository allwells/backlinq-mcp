# CTX Protocol API Key
# Get it from ctxprotocol.com dashboard.
CTX_API_KEY=your_ctx_api_key_here

# Open PageRank API Key
# Get it from domcop.com/openpagerank.
OPEN_PAGERANK_API_KEY=your_openpagerank_api_key_here

# Moz API Credentials
# Requires a paid plan (moz.com/products/api).
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# Server port
# HTTP port the MCP server listens on.
PORT=8000

# Moz API rate limit budget (optional — safe defaults applied)
# MOZ_HOURLY_LIMIT=200
# MOZ_DAILY_LIMIT=2000
# MOZ_CONCURRENCY=10

# SQLite database path
# Path to the SQLite cache database file.
DB_PATH=./backlinq.db
