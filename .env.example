# CTX Protocol API Key — obtain from ctxprotocol.com account dashboard
CTX_API_KEY=your_ctx_api_key_here

# Moz API Credentials (required) — obtain from https://moz.com/products/api
# Paid plan required for /v2/links and /v2/linking_root_domains endpoints
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# DataForSEO API Credentials (unused — kept for reference)
# DATAFORSEO_LOGIN=your_login_here
# DATAFORSEO_PASSWORD=your_password_here

# Server port (default: 8000)
PORT=8000
